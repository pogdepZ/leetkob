# Copy to .env and fill in. .env is git-ignored; never commit a value.
# PA#2 reads only PORT and LOG_LEVEL. The rest are reserved for PA#3+ and documented now so
# that no one invents a differently named variable later.

# --- server ---
PORT=
LOG_LEVEL=

# --- model (PA#3) ---
# Provider and model name, e.g. google / gemini-2.5-flash. Stated in README.md and AI-LOG.md.
LLM_PROVIDER=
LLM_MODEL=
# The provider key. Has a spending cap set on the provider's billing page (see README.md).
# Never passed to the sandbox, never logged, never in a test.
LLM_API_KEY=
# Hard stop per lab, in USD; the checker refuses to call the model past this.
LLM_SPEND_CAP_USD_PER_LAB=
# A model call slower than this becomes an "unsure" verdict.
LLM_TIMEOUT_MS=

# --- storage (PA#3) ---
DATABASE_URL=
REDIS_URL=

# --- sandbox (PA#3): limits the judge enforces on student code ---
SANDBOX_IMAGE=
SANDBOX_CPU_SECONDS=
SANDBOX_WALL_SECONDS=
SANDBOX_MEMORY_MB=
SANDBOX_MAX_PROCESSES=
SANDBOX_MAX_OUTPUT_KB=

# --- sessions (PA#3) ---
SESSION_SECRET=
